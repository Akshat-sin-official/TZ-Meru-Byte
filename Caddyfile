cit.saubhagyalabs.tech, saubhagyalabs.tech, www.saubhagyalabs.tech {
    # 1. API proxy for CIT CampusOS
    handle /api/* {
        reverse_proxy server:5000
    }

    # 2. WhatsApp API & Webhook proxy
    handle /wa/* {
        uri strip_prefix /wa
        reverse_proxy 172.17.0.1:8080
    }

    # 3. WhatsApp Manager Web UI — proxy directly to Evolution-Go's built-in UI server
    handle /wa-ui/* {
        uri strip_prefix /wa-ui
        reverse_proxy 172.17.0.1:8080
    }

    # 4. CIT CampusOS Main Frontend
    handle {
        root * /var/www/cit
        file_server
        try_files {path} /index.html
    }
}
