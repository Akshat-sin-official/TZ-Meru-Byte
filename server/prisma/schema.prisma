datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  department_coordinator
  faculty
  club
}

enum ScheduleStatus {
  draft
  pending_approval
  active
  superseded
  rejected
}

enum BookingDecisionStatus {
  approved
  alternative_offered
  rejected
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  timeout
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  department   String?
  facultyId    String?  @unique
  clubName     String?
  createdAt    DateTime @default(now())

  auditLogs    AuditLog[]
  notifications Notification[]
  whatsAppContacts WhatsAppContact[]
}

model DatasetVersion {
  id          String   @id @default(uuid())
  datasetId   String
  contentHash String   @unique
  isCurrent   Boolean  @default(false)
  rawJson     Json
  createdAt   DateTime @default(now())

  rooms             Room[]
  faculty           Faculty[]
  studentGroups     StudentGroup[]
  courses           Course[]
  sessions          Session[]
  bookingRequests   BookingRequest[]
  midsemExams       MidsemExam[]
  schedules         ScheduleVersion[]
  disruptionJobs    DisruptionJob[]
}

model Room {
  id               String   @id @default(uuid())
  datasetVersionId String
  externalId       String
  name             String
  building         String
  type             String
  capacity         Int
  features         Json
  accessible       Boolean
  allowedUses      Json

  datasetVersion   DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  unavailability   RoomUnavailability[]

  @@unique([datasetVersionId, externalId])
}

model RoomUnavailability {
  id       String @id @default(uuid())
  roomId   String
  day      String
  periods  Json
  reason   String?

  room     Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Faculty {
  id               String   @id @default(uuid())
  datasetVersionId String
  externalId       String
  name             String
  department       String
  maxHoursPerDay   Int      @default(4)
  needsAccessible  Boolean  @default(false)
  unavailable      Json
  preferences      Json

  datasetVersion   DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, externalId])
}

model StudentGroup {
  id               String   @id @default(uuid())
  datasetVersionId String
  externalId       String
  name             String
  year             Int
  department       String
  size             Int
  needsAccessible  Boolean  @default(false)

  datasetVersion   DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, externalId])
}

model Course {
  id               String   @id @default(uuid())
  datasetVersionId String
  externalId       String
  name             String?
  department       String
  year             Int
  lectureHours     Int
  tutorialHours    Int
  labBlocks        Int

  datasetVersion   DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, externalId])
}

model Session {
  id               String   @id @default(uuid())
  datasetVersionId String
  externalId       String
  courseId         String
  kind             String
  groups           Json
  facultyId        String
  size             Int
  duration         Int
  roomTypes        Json
  needsAccessible  Boolean  @default(false)
  basketSlot       String?
  fixedSlot        Json?

  datasetVersion   DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, externalId])
}

model ScheduleVersion {
  id                 String         @id @default(uuid())
  datasetVersionId   String
  versionNumber      Int
  status             ScheduleStatus @default(pending_approval)
  softScoreTotal     Int            @default(0)
  softScoreBreakdown Json?
  hardViolations     Int            @default(0)
  createdById        String?
  approvedById       String?
  createdAt          DateTime       @default(now())
  activatedAt        DateTime?

  datasetVersion     DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  assignments        ScheduleAssignment[]
  bookingDecisions   BookingDecision[]
  sessionOverrides   SessionOverride[]
  examAllocations    ExamAllocation[]

  @@index([datasetVersionId, status])
}

model ScheduleAssignment {
  id                String   @id @default(uuid())
  scheduleVersionId String
  sessionExternalId String
  day               String
  startPeriod       Int
  roomExternalId    String

  scheduleVersion   ScheduleVersion @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)

  @@unique([scheduleVersionId, sessionExternalId])
}

model MidsemExam {
  id               String   @id @default(uuid())
  datasetVersionId String
  externalId       String
  courseIds        Json
  groups           Json
  size             Int
  durationHours    Int

  datasetVersion   DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, externalId])
}

model ExamAllocation {
  id                String   @id @default(uuid())
  scheduleVersionId String
  examExternalId    String
  day               String
  session           String
  rooms             Json

  scheduleVersion   ScheduleVersion @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)

  @@unique([scheduleVersionId, examExternalId])
}

model BookingRequest {
  id                String   @id @default(uuid())
  datasetVersionId  String
  externalId        String
  submittedAt       DateTime
  requester         String
  role              Role
  requestedCategory String
  effectiveCategory String
  title             String
  attendance        Int
  durationPeriods   Int
  windows           Json
  roomTypes         Json
  needs             Json
  requestedRoom     String?
  mandatoryForGroups Json
  seriesId          String?
  rawText           String?  @db.Text
  isCancelled       Boolean  @default(false)

  datasetVersion    DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  decisions         BookingDecision[]

  @@unique([datasetVersionId, externalId])
}

model BookingDecision {
  id                String                @id @default(uuid())
  scheduleVersionId String
  requestId         String
  status            BookingDecisionStatus
  day               String?
  startPeriod       Int?
  endPeriod         Int?
  roomExternalId    String?
  reason            String                @db.Text

  scheduleVersion   ScheduleVersion       @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)
  request           BookingRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([scheduleVersionId, requestId])
}

model SessionOverride {
  id                String   @id @default(uuid())
  scheduleVersionId String
  sessionExternalId String
  day               String
  startPeriod       Int
  roomExternalId    String
  displacedByReqId  String

  scheduleVersion   ScheduleVersion @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)

  @@unique([scheduleVersionId, sessionExternalId])
}

model DisruptionJob {
  id               String    @id @default(uuid())
  datasetVersionId String
  baseScheduleId   String
  status           JobStatus @default(queued)
  changesJson      Json
  resultProposalId String?
  sessionsMoved    Int?
  timeChanged      Int?
  roomOnlyChanged  Int?
  createdAt        DateTime  @default(now())

  datasetVersion   DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  timestamp  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhatsAppContact {
  id        String   @id @default(uuid())
  userId    String?
  phone     String   @unique
  name      String?
  role      Role     @default(club)
  optedIn   Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

