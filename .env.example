# ==========================================
# Campora — Environment Configuration Template
# ==========================================

# Node.js Server Port
PORT=5000

# MySQL Database Connection URL
DATABASE_URL="mysql://root:password@localhost:3306/cit_campus_os"

# JWT Secret Key for Session Authentication
JWT_SECRET="cit-campus-os-super-secret-jwt-key-2027"

# Python CP-SAT Optimizer Microservice URL
OPTIMIZER_URL="http://127.0.0.1:8001"

# Dataset & Validator Paths (Relative or Absolute)
DATASET_PATH="../docs/PS/CrunchWeek_StarterPack (1)/CrunchWeek_StarterPack/data/cit_public.json"
VALIDATOR_PATH="../docs/PS/CrunchWeek_StarterPack (1)/CrunchWeek_StarterPack/validator.py"

# Optional Gemini API Key for Copilot (Deterministic semantic fallback active if unset)
GEMINI_API_KEY=""

# n8n Cloud AI Workflows Integration
N8N_BASE_URL="https://techzephyr.app.n8n.cloud"
N8N_WEBHOOK_SECRET="your_rotated_secret"
N8N_WF01_PATH="cit/ai/booking-intake"
N8N_WF02_PATH="cit/ai/schedule-change"
N8N_WF03_PATH="cit/ai/explain-decision"

# Evolution-Go WhatsApp Gateway Integration
EVOLUTION_URL="http://127.0.0.1:8080"
EVOLUTION_GLOBAL_KEY="your_evolution_global_api_key"
EVOLUTION_INSTANCE="cit_bot"
EVOLUTION_TOKEN="your_instance_token"
